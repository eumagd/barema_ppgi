// =====================================================================
// Banco de dados — Plataforma de Gerenciamento de Baremas (PPGI/UFAL)
//
// Esquema escrito no Prisma ORM a partir do Modelo ER (Sprint 7).
// O Prisma gera a migração inicial (prisma/migrations/*_init).
// O que o Prisma não consegue expressar (CHECKs, gatilhos, índices
// parciais e a view de resumo) está na migração *_ajustes_manuais.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enumerações
// ---------------------------------------------------------------------

/// Especialização parcial e disjunta de DOCENTE (PERMANENTE | COLABORADOR).
/// Nulo = docente do IC sem vínculo com o PPGI.
enum VinculoPpgi {
  PERMANENTE
  COLABORADOR

  @@map("vinculo_ppgi")
}

/// Categoria (união) AUTOR = DOCENTE ∪ DISCENTE ∪ EXTERNO.
enum TipoAutor {
  DOCENTE
  DISCENTE
  EXTERNO

  @@map("tipo_autor")
}

/// Especialização disjunta de VEICULO.
enum TipoVeiculo {
  PERIODICO
  CONFERENCIA

  @@map("tipo_veiculo")
}

enum Estrato {
  A1
  A2
  A3
  A4
  B1
  B2
  B3
  B4
  C

  @@map("estrato")
}

/// Especialização disjunta de AVALIACAO.
enum TipoAvaliacao {
  CREDENCIAMENTO
  RECREDENCIAMENTO

  @@map("tipo_avaliacao")
}

enum StatusAvaliacao {
  EM_ANDAMENTO
  DEFERIDO
  INDEFERIDO
  CANCELADO

  @@map("status_avaliacao")
}

enum StatusRelatorio {
  RASCUNHO
  GERADO
  ENVIADO

  @@map("status_relatorio")
}

enum PerfilUsuario {
  SECRETARIA
  COORDENACAO

  @@map("perfil_usuario")
}

/// Origem do estrato Qualis (RF-BE17), na ordem de busca: CAPES → PUC-RS → Scopus.
/// EVENTOS = tabela Qualis Eventos da Computação; MANUAL = fila de classificação manual (RF-BE05).
enum FonteQualis {
  CAPES
  PUC_RS
  SCOPUS
  EVENTOS
  MANUAL

  @@map("fonte_qualis")
}

/// Conector que originou a carga (RF-BE18).
enum FonteImportacao {
  QLATTES_CSV
  PLANILHA_TRANSICAO
  XML_LATTES
  /// Cargas das tabelas Qualis (POST /api/qualis/cargas).
  QUALIS_CAPES
  QUALIS_PUC_RS
  QUALIS_SCOPUS
  QUALIS_EVENTOS

  @@map("fonte_importacao")
}

enum StatusImportacao {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  FALHA

  @@map("status_importacao")
}

/// O que foi comparado no Fuzzy Match.
enum TipoCorrespondencia {
  PUBLICACAO
  AUTOR

  @@map("tipo_correspondencia")
}

/// Etapa do pipeline que gerou a nota (RF-BE07 a RF-BE10).
enum MotivoCorrespondencia {
  DOI
  ISSN_TITULO
  SIMILARIDADE_TITULO
  NOME_AUTOR

  @@map("motivo_correspondencia")
}

/// AUTOMATICA = nota ≥ corte de confirmação; PENDENTE = faixa de revisão humana.
enum DecisaoCorrespondencia {
  AUTOMATICA
  PENDENTE
  CONFIRMADA
  REJEITADA

  @@map("decisao_correspondencia")
}

/// Situação do docente na UFAL (exibida em professores.html e perfil.html).
enum SituacaoFuncional {
  EFETIVO
  SUBSTITUTO
  VISITANTE
  APOSENTADO

  @@map("situacao_funcional")
}

enum NivelDisciplina {
  GRADUACAO
  POS_GRADUACAO

  @@map("nivel_disciplina")
}

// ---------------------------------------------------------------------
// Pessoas
// ---------------------------------------------------------------------

model Docente {
  id_docente               Int               @id @default(autoincrement())
  matricula                String            @unique @db.VarChar(20)
  nome                     String            @db.VarChar(150)
  email                    String            @unique @db.VarChar(150)
  departamento             String?           @db.VarChar(150)
  situacao_funcional       SituacaoFuncional @default(EFETIVO)
  url_lattes               String?           @db.VarChar(255)
  /// ID do Lattes (16 dígitos): sustenta a validação de vínculo da importação (RF-BE03).
  id_lattes                String?           @unique @db.Char(16)
  data_ultima_atualizacao  DateTime?         @db.Date
  /// Mapeamento da especialização PERMANENTE/COLABORADOR em tabela única.
  vinculo                  VinculoPpgi?
  /// Início do vínculo atual com o PPGI: recém-credenciados (< 24 meses) e progressão Colaborador → Permanente.
  data_vinculo             DateTime?         @db.Date
  /// RF16: data em que o docente declarou que não participará do ciclo.
  data_recusa_participacao DateTime?         @db.Date

  orientandos   Discente[]     @relation("Orienta")
  coorientacoes Coorientacao[]
  autor         Autor?
  avaliacoes    Avaliacao[]
  turmas        Turma[]
  importacoes   Importacao[]

  @@map("docente")
}

model Discente {
  id_discente    Int       @id @default(autoincrement())
  matricula      String    @unique @db.VarChar(20)
  nome           String    @db.VarChar(150)
  ano_ingresso   Int
  /// Data da defesa; nula = orientação em andamento (critério de Orientação, janela de 24 meses).
  data_conclusao DateTime? @db.Date
  /// Relacionamento Orienta (PERMANENTE 1 : N DISCENTE, máx. 8) — validado por gatilho.
  id_orientador  Int?

  orientador    Docente?       @relation("Orienta", fields: [id_orientador], references: [id_docente], onDelete: SetNull)
  coorientacoes Coorientacao[]
  autor         Autor?

  @@index([id_orientador])
  @@map("discente")
}

model Externo {
  id_externo  Int     @id @default(autoincrement())
  nome        String  @db.VarChar(150)
  inst_origem String? @db.VarChar(150)

  coorientacoes Coorientacao[]
  autor         Autor?

  @@map("externo")
}

/// Relacionamento Coorienta (M:N): um docente OU um externo coorienta um discente.
model Coorientacao {
  id_coorientacao Int  @id @default(autoincrement())
  id_discente     Int
  id_docente      Int?
  id_externo      Int?

  discente Discente @relation(fields: [id_discente], references: [id_discente], onDelete: Cascade)
  docente  Docente? @relation(fields: [id_docente], references: [id_docente], onDelete: Cascade)
  externo  Externo? @relation(fields: [id_externo], references: [id_externo], onDelete: Cascade)

  @@index([id_discente])
  @@map("coorientacao")
}

/// Categoria AUTOR: chave substituta + referência para exatamente uma superclasse.
model Autor {
  id_autor     Int       @id @default(autoincrement())
  tipo         TipoAutor
  /// Nome como aparece nas publicações (usado no Fuzzy Match).
  nome_citacao String    @db.VarChar(255)
  id_docente   Int?      @unique
  id_discente  Int?      @unique
  id_externo   Int?      @unique

  docente          Docente?           @relation(fields: [id_docente], references: [id_docente], onDelete: Cascade)
  discente         Discente?          @relation(fields: [id_discente], references: [id_discente], onDelete: Cascade)
  externo          Externo?           @relation(fields: [id_externo], references: [id_externo], onDelete: Cascade)
  autorias         Autoria[]
  /// Variações do nome de citação ("SANTOS, M.", "Magdiel Santos"...) — RF-BE09.
  nomes_citacao    AutorNomeCitacao[]
  correspondencias Correspondencia[]

  @@map("autor")
}

/// Variação de nome de citação de um autor, usada para casar coautores do CSV (RF-BE09).
model AutorNomeCitacao {
  id_nome_citacao  Int    @id @default(autoincrement())
  id_autor         Int
  nome             String @db.VarChar(255)
  /// Minúsculas, sem acentos e sem pontuação.
  nome_normalizado String @db.VarChar(255)

  autor Autor @relation(fields: [id_autor], references: [id_autor], onDelete: Cascade)

  @@unique([id_autor, nome_normalizado])
  @@index([nome_normalizado])
  @@map("autor_nome_citacao")
}

// ---------------------------------------------------------------------
// Produção científica
// ---------------------------------------------------------------------

model Veiculo {
  id_veiculo Int         @id @default(autoincrement())
  nome       String      @db.VarChar(255)
  /// ISSN (periódico) ou sigla (conferência).
  issn_sigla String      @db.VarChar(30)
  tipo       TipoVeiculo

  estratos    EstratoQualis[]
  publicacoes Publicacao[]

  @@unique([tipo, issn_sigla])
  @@map("veiculo")
}

/// Entidade fraca de VEICULO (relacionamento identificador Pertence).
model EstratoQualis {
  id_veiculo      Int
  ano_base        Int
  area_de_atuacao String      @db.VarChar(100)
  estrato         Estrato
  pontuacao       Decimal     @db.Decimal(10, 4)
  /// Origem do estrato, exibida no perfil como no QLattes (RF-BE17).
  fonte           FonteQualis @default(CAPES)
  /// Obrigatória quando fonte = MANUAL (fila de classificação de Qualis "N").
  justificativa   String?     @db.Text
  /// Carga que trouxe este estrato (nula para classificação manual).
  id_importacao   Int?

  veiculo    Veiculo     @relation(fields: [id_veiculo], references: [id_veiculo], onDelete: Cascade)
  importacao Importacao? @relation(fields: [id_importacao], references: [id_importacao], onDelete: SetNull)

  /// A fonte entra na chave: o mesmo ISSN pode ter estrato na CAPES, na PUC-RS e no Scopus,
  /// e a classificação escolhe pela ordem hierárquica (RF-BE04).
  @@id([id_veiculo, ano_base, area_de_atuacao, fonte])
  @@index([id_importacao])
  /// Substituição de uma carga anterior da mesma fonte, ano-base e área.
  @@index([fonte, ano_base, area_de_atuacao])
  @@map("estrato_qualis")
}

model Publicacao {
  id_publicacao      Int      @id @default(autoincrement())
  titulo             String   @db.VarChar(500)
  /// Minúsculas, sem acentos e sem pontuação; índice GIN pg_trgm para o Fuzzy Match.
  titulo_normalizado String?  @db.VarChar(500)
  doi                String?  @db.VarChar(255)
  ano_publicacao     Int
  /// Grau de correspondência (0–100) devolvido pelo Fuzzy Match.
  correspondencia    Decimal? @db.Decimal(5, 2)
  /// Relacionamento Publicada Em (N:1).
  id_veiculo         Int?
  /// Carga que trouxe a publicação (rastreabilidade, RF-BE16).
  id_importacao      Int?
  /// Correspondência confirmada: esta publicação é a mesma que `id_mesclada_em` e suas
  /// autorias foram movidas para lá. Publicações mescladas não entram na produção.
  id_mesclada_em     Int?

  veiculo                    Veiculo?              @relation(fields: [id_veiculo], references: [id_veiculo], onDelete: SetNull)
  importacao                 Importacao?           @relation(fields: [id_importacao], references: [id_importacao], onDelete: SetNull)
  mesclada_em                Publicacao?           @relation("Mescla", fields: [id_mesclada_em], references: [id_publicacao], onDelete: SetNull)
  publicacoes_mescladas      Publicacao[]          @relation("Mescla")
  autorias                   Autoria[]
  avaliacoes                 AvaliacaoPublicacao[]
  correspondencias_origem    Correspondencia[]     @relation("CorrespondenciaOrigem")
  correspondencias_candidata Correspondencia[]     @relation("CorrespondenciaCandidata")

  @@index([id_veiculo])
  @@index([ano_publicacao])
  @@index([doi])
  @@index([id_importacao])
  @@index([id_mesclada_em])
  @@index([titulo_normalizado(ops: raw("gin_trgm_ops"))], type: Gin, map: "publicacao_titulo_normalizado_trgm_idx")
  @@map("publicacao")
}

/// Relacionamento Escreve (AUTOR M:N PUBLICACAO) com o atributo ordem_autoria.
model Autoria {
  id_publicacao Int
  id_autor      Int
  ordem_autoria Int

  publicacao Publicacao @relation(fields: [id_publicacao], references: [id_publicacao], onDelete: Cascade)
  autor      Autor      @relation(fields: [id_autor], references: [id_autor], onDelete: Cascade)

  @@id([id_publicacao, id_autor])
  @@unique([id_publicacao, ordem_autoria])
  @@index([id_autor])
  @@map("autoria")
}

// ---------------------------------------------------------------------
// Processo avaliativo
// ---------------------------------------------------------------------

model Resolucao {
  id_resolucao   Int      @id @default(autoincrement())
  /// Ex.: "1/2025".
  numero_ano     String   @unique @db.VarChar(20)
  data_vigencia  DateTime @db.Date
  link_documento String?  @db.VarChar(500)

  avaliacoes Avaliacao[]
  parametros Parametro[]

  @@map("resolucao")
}

/// Parâmetros versionados por resolução: pesos por estrato, mínimos exigidos e cortes do
/// Fuzzy Match, ajustáveis sem novo deploy (RNF-BE05).
model Parametro {
  id_parametro Int     @id @default(autoincrement())
  id_resolucao Int
  /// Ex.: "pesos_estrato", "credenciamento.pontuacao_minima", "fuzzy.corte_confirmacao".
  chave        String  @db.VarChar(100)
  valor        Json
  descricao    String? @db.VarChar(500)

  resolucao Resolucao @relation(fields: [id_resolucao], references: [id_resolucao], onDelete: Cascade)

  @@unique([id_resolucao, chave])
  @@map("parametro")
}

/// AVALIACAO e suas subclasses CREDENCIAMENTO/RECREDENCIAMENTO em tabela única.
model Avaliacao {
  id_processo               Int             @id @default(autoincrement())
  tipo                      TipoAvaliacao
  data_solicitacao          DateTime        @default(now()) @db.Date
  status                    StatusAvaliacao @default(EM_ANDAMENTO)
  pontuacao_pesquisa        Decimal?        @db.Decimal(10, 4)
  cumpriu_docencia          Boolean?
  cumpriu_orientacao        Boolean?
  possui_coautoria_discente Boolean?
  valido_ate                DateTime?       @db.Date
  status_relatorio          StatusRelatorio @default(RASCUNHO)
  data_envio_relatorio      DateTime?
  /// Relacionamento Submete (DOCENTE 1:N AVALIACAO).
  id_docente                Int
  /// Relacionamento Regida Por (AVALIACAO N:1 RESOLUCAO).
  id_resolucao              Int

  docente     Docente               @relation(fields: [id_docente], references: [id_docente], onDelete: Restrict)
  resolucao   Resolucao             @relation(fields: [id_resolucao], references: [id_resolucao], onDelete: Restrict)
  publicacoes AvaliacaoPublicacao[]

  @@index([id_docente])
  @@index([id_resolucao])
  @@map("avaliacao")
}

/// Publicações consideradas em cada avaliação (RF06 e RF13).
model AvaliacaoPublicacao {
  id_processo       Int
  id_publicacao     Int
  /// false = coautoria desmarcada na revisão manual.
  considerada       Boolean  @default(true)
  /// Pontos atribuídos ao docente após a divisão entre coautores.
  pontos_atribuidos Decimal? @db.Decimal(10, 4)

  avaliacao  Avaliacao  @relation(fields: [id_processo], references: [id_processo], onDelete: Cascade)
  publicacao Publicacao @relation(fields: [id_publicacao], references: [id_publicacao], onDelete: Cascade)

  @@id([id_processo, id_publicacao])
  @@index([id_publicacao])
  @@map("avaliacao_publicacao")
}

// ---------------------------------------------------------------------
// Acesso à plataforma
// ---------------------------------------------------------------------

model Usuario {
  id_usuario Int           @id @default(autoincrement())
  nome       String        @db.VarChar(150)
  email      String        @unique @db.VarChar(150)
  senha_hash String        @db.VarChar(255)
  perfil     PerfilUsuario
  criado_em  DateTime      @default(now())

  tokens_redefinicao TokenRedefinicaoSenha[]
  lotes_importacao   LoteImportacao[]
  importacoes        Importacao[]
  correspondencias   Correspondencia[]

  @@map("usuario")
}

/// Token temporário enviado por e-mail na recuperação de senha (guardamos só o hash).
model TokenRedefinicaoSenha {
  id_token   Int       @id @default(autoincrement())
  id_usuario Int
  token_hash String    @unique @db.VarChar(128)
  expira_em  DateTime
  usado_em   DateTime?
  criado_em  DateTime  @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@index([id_usuario])
  @@map("token_redefinicao_senha")
}

// ---------------------------------------------------------------------
// Docência (critério do recredenciamento, RF09)
// ---------------------------------------------------------------------

model Disciplina {
  id_disciplina   Int             @id @default(autoincrement())
  codigo          String          @unique @db.VarChar(20)
  nome            String          @db.VarChar(200)
  nivel           NivelDisciplina
  /// "Estudo Dirigido" não conta para o critério de Docência.
  estudo_dirigido Boolean         @default(false)

  turmas Turma[]

  @@map("disciplina")
}

/// Disciplina ministrada por um docente em um semestre.
model Turma {
  id_turma      Int @id @default(autoincrement())
  id_disciplina Int
  id_docente    Int
  ano           Int
  semestre      Int

  disciplina Disciplina @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: Cascade)
  docente    Docente    @relation(fields: [id_docente], references: [id_docente], onDelete: Cascade)

  @@unique([id_disciplina, id_docente, ano, semestre])
  @@index([id_docente, ano])
  @@map("turma")
}

// ---------------------------------------------------------------------
// Ingestão e Fuzzy Match
// ---------------------------------------------------------------------

/// Cada carga de arquivo (RF-BE16): fonte, hash para idempotência, estado e contagens.
model Importacao {
  id_importacao Int              @id @default(autoincrement())
  fonte         FonteImportacao
  nome_arquivo  String           @db.VarChar(255)
  /// SHA-256 do arquivo: reimportar o mesmo arquivo não duplica dados (RNF-BE02).
  hash_arquivo  String           @db.Char(64)
  status        StatusImportacao @default(PENDENTE)
  /// Ex.: { "linhas": 120, "publicacoes_novas": 30, "duplicadas": 85, "erros": 5 }.
  contagens     Json?
  erros         Json?
  /// Docente do upload individual; nulo em lote (casado por linha/arquivo).
  id_docente    Int?
  id_usuario    Int?
  criado_em     DateTime         @default(now())
  iniciado_em   DateTime?
  finalizado_em DateTime?

  docente     Docente?        @relation(fields: [id_docente], references: [id_docente], onDelete: SetNull)
  usuario     Usuario?        @relation(fields: [id_usuario], references: [id_usuario], onDelete: SetNull)
  publicacoes Publicacao[]
  estratos    EstratoQualis[]

  @@index([hash_arquivo])
  @@index([status])
  @@map("importacao")
}

/// Par comparado no Fuzzy Match, com nota, motivo e decisão (RF-BE11).
/// Publicação × publicação candidata, ou nome lido no CSV × autor cadastrado.
model Correspondencia {
  id_correspondencia      Int                    @id @default(autoincrement())
  tipo                    TipoCorrespondencia
  id_publicacao           Int
  id_publicacao_candidata Int?
  /// Nome do coautor como veio no CSV (tipo = AUTOR).
  nome_lido               String?                @db.VarChar(255)
  id_autor_candidato      Int?
  nota                    Decimal                @db.Decimal(5, 2)
  motivo                  MotivoCorrespondencia
  decisao                 DecisaoCorrespondencia @default(PENDENTE)
  justificativa           String?                @db.Text
  /// Autorias movidas na mescla: [{ id_autor, ordem_autoria }] (para desfazer se a decisão mudar).
  autores_movidos         Json?
  id_usuario              Int?
  decidido_em             DateTime?
  criado_em               DateTime               @default(now())

  publicacao           Publicacao  @relation("CorrespondenciaOrigem", fields: [id_publicacao], references: [id_publicacao], onDelete: Cascade)
  publicacao_candidata Publicacao? @relation("CorrespondenciaCandidata", fields: [id_publicacao_candidata], references: [id_publicacao], onDelete: Cascade)
  autor_candidato      Autor?      @relation(fields: [id_autor_candidato], references: [id_autor], onDelete: Cascade)
  usuario              Usuario?    @relation(fields: [id_usuario], references: [id_usuario], onDelete: SetNull)

  @@index([decisao, nota])
  @@index([id_publicacao])
  @@map("correspondencia")
}

/// Importação em lote (.zip com vários CSVs), processada em segundo plano (RF-BE13, RNF-BE04).
/// `itens` guarda o andamento de cada arquivo: [{ arquivo, status, docente?, id_importacao?, erro? }].
model LoteImportacao {
  id_lote       Int              @id @default(autoincrement())
  nome_arquivo  String           @db.VarChar(255)
  status        StatusImportacao @default(PENDENTE)
  total         Int
  itens         Json
  id_usuario    Int?
  criado_em     DateTime         @default(now())
  iniciado_em   DateTime?
  finalizado_em DateTime?

  usuario Usuario? @relation(fields: [id_usuario], references: [id_usuario], onDelete: SetNull)

  @@index([status])
  @@map("lote_importacao")
}
