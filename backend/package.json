{
  "name": "barema-ppgi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Back end e banco de dados da Plataforma de Gerenciamento de Baremas do PPGI/UFAL",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}
