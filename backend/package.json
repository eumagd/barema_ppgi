{
  "name": "barema-ppgi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Back end e banco de dados da Plataforma de Gerenciamento de Baremas do PPGI/UFAL",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "test:integracao": "node scripts/testar-integracao.js",
    "preparar": "node scripts/preparar-banco.js",
    "criar-usuario": "node scripts/criar-usuario.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "adm-zip": "^0.6.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "supertest": "^7.3.2"
  },
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  }
}
