# Conexão com o PostgreSQL (o docker-compose.yml sobe este banco).
# DB_PORT: porta do PostgreSQL do Docker no seu computador (padrão 5432). Mantenha igual à da DATABASE_URL.
DB_PORT=5432
DATABASE_URL="postgresql://ppgi:ppgi@localhost:5432/barema_ppgi?schema=public"

# API
PORT=3000
# Troque por um valor aleatório longo em produção (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="8h"
# Origem do front end (CORS) e base dos links enviados por e-mail.
FRONTEND_URL="http://localhost:5500"

# SMTP (opcional). Sem SMTP_HOST, os e-mails são apenas exibidos no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PPGI/UFAL <nao-responda@ic.ufal.br>"
